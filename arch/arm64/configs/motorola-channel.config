# Motorola Moto G7 Play (channel) validated mainline bring-up config.
# Keep boot-critical requirements in-tree so build wrappers do not need
# to inject them from an external configuration fragment.

# Core boot/userspace requirements
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_CONFIGFS_FS=y

# Channel display and console
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_MOTOROLA_CHANNEL_568_DJN=m
CONFIG_DRM_PANEL_MOTOROLA_CHANNEL_569_DJN=m
CONFIG_DRM_PANEL_MOTOROLA_CHANNEL_569_DSBJ=m
CONFIG_DRM_PANEL_MOTOROLA_CHANNEL_570_DSBJ=m
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# Root filesystem on eMMC / microSD
CONFIG_EXT4_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y

# USB controller and RNDIS gadget path
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y

# Networking required for SSH over USB and normal IP userspace
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y

# Channel WCNSS / Pronto Wi-Fi path
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_QCOM_WCNSS_PIL=m
CONFIG_QCOM_WCNSS_CTRL=m
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y

# Bring-up diagnostics and persistent crash logs
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEBUG_FS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Device-specific release identity
CONFIG_LOCALVERSION="-Channel-Revived"
# CONFIG_LOCALVERSION_AUTO is not set
